<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.1</Version>
    <PackageId>Deedle.DotNet.Interactive.Extension</PackageId>
    <IsPackable>true</IsPackable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <OutputType>Library</OutputType>
    <PackageDescription>Experimental Deedle formatters for dotnet interactive notebooks</PackageDescription>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ingted/Deedle.DotNet.Interactive.Extension</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ingted/Deedle.DotNet.Interactive.Extension</RepositoryUrl>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    <NoWarn>$(NoWarn);NU5100</NoWarn><!-- dll outside of lib/ folder -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Formatting.fs" />
    <Compile Include="ContextPrint.fs" />
    <Compile Include="DFPrint.fs" />
    <Compile Include="Extension.fs" />
  </ItemGroup>

  <ItemGroup>
	  <Compile Remove="bin\**" />
	  <EmbeddedResource Remove="bin\**" />
	  <None Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.402" />
    <PackageReference Include="Deedle" Version="8.1.0" />
    <PackageReference Include="Microsoft.DotNet.Interactive" Version="1.0.0-dev.26522.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.DotNet.Interactive.Formatting" Version="1.0.0-dev.26522.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.DotNet.Interactive.FSharp" Version="1.0.0-dev.26522.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="bin\Debug\net10.0\/Deedle.DotNet.Interactive.Extension.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/Deedle.DotNet.Interactive.Extension.dll" Pack="true" PackagePath="interactive-extensions/dotnet" />
    <None Include="..\..\Readme.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="[DEPRECATED]PostBuildEvent.ps1" />
    <None Include="..\..\PostBuildEvent.ps1" Link="PostBuildEvent.ps1" />
  </ItemGroup>

  <PropertyGroup>
    <PublishNuGetAfterPack Condition="'$(PublishNuGetAfterPack)' == '' and '$(BuildingInsideVisualStudio)' == 'true'">true</PublishNuGetAfterPack>
  </PropertyGroup>

  <Target Name="PostPackNugetDeployWindows"
          AfterTargets="Pack"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and ('$(Configuration)' == 'Debug' or '$(Configuration)' == 'Release')">
    <Exec Condition="'$(Configuration)' != 'Release' or '$(PublishNuGetAfterPack)' != 'true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))&quot;" />
    <Exec Condition="'$(Configuration)' == 'Release' and '$(PublishNuGetAfterPack)' == 'true'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\PostBuildEvent.ps1&quot; -PackageId &quot;$(PackageId)&quot; -PackageVersion &quot;$(PackageVersion)&quot; -Configuration &quot;$(Configuration)&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -PackageFilePath &quot;$([System.IO.Path]::Combine('$(PackageOutputPath)', '$(PackageId).$(PackageVersion).nupkg'))&quot; -PushRelease" />
  </Target>
</Project>
